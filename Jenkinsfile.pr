pipeline {
  agent any
  options {
    timestamps()
    timeout(time: 15, unit: 'MINUTES')
  }
  environment {
    IMAGE = "devops-app:pr-${env.CHANGE_ID}-${env.BUILD_NUMBER}"
    CONTAINER = "devops-app-pr-${env.BUILD_NUMBER}"
  }
  stages {
    stage('Checkout') {
      steps {
        checkout scm
        sh 'git log -1 --oneline'
      }
    }
    stage('Setup') {
      steps {
        sh '''
          mkdir -p artifacts
          chmod +x smoke_test.sh
          docker --version
        '''
      }
    }
    stage('Build') {
      steps {
        sh '''
          if docker build -t $IMAGE . > artifacts/build.log 2>&1; then
            cat artifacts/build.log
          else
            cat artifacts/build.log
            exit 1
          fi
        '''
      }
    }
    stage('Run (Docker)') {
      steps {
        sh '''
          docker run -d --name $CONTAINER $IMAGE
          IP=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' $CONTAINER)
          echo "Container IP: $IP"
          for i in $(seq 1 20); do
            curl -s -o /dev/null http://$IP:5000/health && break
            sleep 1
          done
        '''
      }
    }
    stage('Smoke Test') {
      steps {
        sh '''
          IP=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' $CONTAINER)
          ./smoke_test.sh http://$IP:5000 > artifacts/smoke_result.txt 2>&1
          RC=$?
          cat artifacts/smoke_result.txt
          exit $RC
        '''
      }
    }
    stage('Archive Artifacts') {
      steps {
        archiveArtifacts artifacts: 'artifacts/**', allowEmptyArchive: true
      }
    }
  }
  post {
    always {
      writeFile file: 'artifacts/pipeline_report.txt', text: "Job: ${env.JOB_NAME}\nBuild: #${env.BUILD_NUMBER}\nPR: ${env.CHANGE_ID}\nResult: ${currentBuild.currentResult}\nImage: ${env.IMAGE}\n"
      sh 'docker logs $CONTAINER > artifacts/container.log 2>&1 || true'
      archiveArtifacts artifacts: 'artifacts/**', allowEmptyArchive: true
      sh '''
        docker rm -f $CONTAINER || true
        docker rmi -f $IMAGE || true
      '''
    }
  }
}